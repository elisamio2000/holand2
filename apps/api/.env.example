# ==========================================
# Holand Platform — API Environment (template)
# Copy to .env and adjust for your machine.
# ==========================================

# ---- Application ----
APP_ENV=development
APP_SECRET_KEY=change-this-secret-key-in-production-min-32-chars
DEBUG=true

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://holand:holand_dev_pass@localhost:5432/holand_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET_KEY=change-this-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@holand.app

# ---- Rate Limiting ----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ASSESSMENT_START_PER_HOUR=10

# ---- Storage (for PDF reports) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
