# ==========================================
# Holand Platform — Web App Environment (template)
# Copy this file to .env.local and adjust values for your machine.
# ==========================================

# ---- Server ----
# FastAPI backend (apps/api) defaults to 8000, keep this on a different port.
PORT=3000

# ---- NextAuth ----
NEXTAUTH_SECRET=your-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_TRUST_HOST=true

# ---- Backend API (FastAPI, apps/api) ----
AUTH_API_URL=http://localhost:8000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
API_GATEWAY_URL=http://localhost:8000
# Direct client for analytics + expert-lab (falls back to NEXT_PUBLIC_API_GATEWAY_URL)
NEXT_PUBLIC_HOLAND_API_URL=http://localhost:8000

# ---- Google OAuth (optional, leave empty to disable) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Dev-only auth bypass ----
# When the backend is unreachable, login with admin / admin123
# AUTH_DEV_BYPASS=true
