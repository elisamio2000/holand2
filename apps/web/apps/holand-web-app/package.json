  "name": "holand-web-app",
  "version": "0.1.0",
  "description": "Holand Platform — Next.js web app for Holland/MBTI assessments and career guidance",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "lint": "next lint",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "start": "node ./scripts/start-interactive.mjs",
    "clean": "rm -rf node_modules .next .cache .turbo",
    "cache:clean": "rm -rf .next .cache .turbo",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/media-session-expand.spec.ts e2e/dev-hub.spec.ts",
    "analyze:dashboard": "cross-env ANALYZE=true next build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "i18n:scan": "node src/platform/i18n-governance/index.mjs",
    "i18n:check": "node src/platform/i18n-governance/index.mjs --check --fail-on-new",
    "check:fast": "pnpm lint && pnpm test && pnpm i18n:check",
    "check": "pnpm check:fast",
    "check:ci": "pnpm check:fast && pnpm build-storybook",
    "fetch-test-media": "node scripts/fetch-test-media.mjs"
  },
